# Copy to .env; scripts/bootstrap.py generates private local values for the first two.
ECHO_API_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_24_CHARS
ECHO_SIGNING_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS
POWERCONTEXT_URL=http://127.0.0.1:18741
POWERCONTEXT_SERVER_HTTP_PORT=18741
POWERCONTEXT_TOKEN=
ECHO_HOST=127.0.0.1
ECHO_PORT=18742
# Optional custom front-end -> Dify Workflow API (base URL includes /v1).
DIFY_API_URL=
DIFY_APP_API_KEY=
